# Режим стенда: PUBLIC_HOST задан. Сертификат на этот адрес выпускает и
# продлевает модуль ngx_http_acme_module внутри процесса nginx и подменяет
# без перезапуска. Переменные ${PUBLIC_HOST} и ${ACME_DIRECTORY} подставляет
# скрипт выбора режима при старте контейнера.

# DNS докера: по нему nginx находит и dmc268-api, и ACME-сервер — внешние
# имена он передаёт резолверу хоста.
resolver 127.0.0.11 valid=10s ipv6=off;

# Частота приёма трейсов браузера (location = /otlp/v1/traces в site.conf):
# зона объявляется на уровне http, поэтому живёт здесь, рядом с resolver, в
# обоих режимах. Кабинет шлёт пачку спанов раз в несколько секунд и не больше
# 100 ошибок за загрузку страницы; 5 запросов в секунду с адреса с запасом
# покрывают и офис за одним NAT.
limit_req_zone $binary_remote_addr zone=otlp:1m rate=5r/s;

# Вход в Grafana (location ~ ^/grafana/login/?$ в grafana.conf): считаются только
# POST — попытки входа; у GET ключ пустой, и nginx его не учитывает. 10 попыток
# в минуту с адреса и запас 10 подряд хватает человеку, ошибившемуся паролем,
# и режут перебор.
map $request_method $grafana_login_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $grafana_login_key zone=grafana_login:1m rate=10r/m;

# Переход на WebSocket для Grafana Live (grafana.conf):
# запросу с Upgrade — Connection: upgrade, остальным — close, как без map.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# Cookie без сессии кабинета для Grafana (proxy_set_header Cookie в
# grafana.conf): браузер прикладывает session (Path=/) и на порт Grafana —
# cookie портом не разделяются. Срезается только session, остальные, в том
# числе grafana_session, проходят: «grafana_session=a; session=x; foo=1» →
# «grafana_session=a; foo=1». Пустой результат nginx не отправляет вовсе.
map $http_cookie $cookie_without_session {
    default $http_cookie;
    "~^(?<pre>(?:.*;\s*)?)session=[^;]*(?:;\s*)?(?<post>.*)$" "$pre$post";
}

# Адрес Grafana для редиректа со старых /grafana… кабинета (site.conf).
map $host $grafana_origin {
    default https://${PUBLIC_HOST}:8443;
}

acme_issuer letsencrypt {
    uri ${ACME_DIRECTORY};
    # На IP Let's Encrypt выдаёт сертификаты только с этим профилем: 160
    # часов. require — не откатываться молча на другой профиль, а падать.
    profile shortlived require;
    # Ключ аккаунта и выпущенные сертификаты. Каталог лежит на томе: без
    # этого каждый передеплой выпускал бы сертификат заново и упирался в
    # лимиты Let's Encrypt.
    state_path /var/lib/nginx-acme;
    accept_terms_of_service;
}

server {
    # Порт 80 нужен модулю для проверки HTTP-01: запросы проверки он
    # обслуживает сам, раньше этого location. Остальное уходит на HTTPS.
    listen 80;
    server_name _;

    location / {
        return 301 https://${PUBLIC_HOST}$request_uri;
    }
}

server {
    listen 443 ssl;
    # HTTP/3 идёт по UDP на тот же порт. Браузер приходит сначала по TCP и
    # переходит на QUIC, узнав о нём из Alt-Svc; где UDP закрыт, остаётся
    # HTTP/2.
    listen 443 quic reuseport;
    http2 on;
    http3 on;
    server_name ${PUBLIC_HOST};

    add_header Alt-Svc 'h3=":443"; ma=86400' always;
    # HSTS: браузер, получивший заголовок, сам переписывает http:// на
    # https:// и не делает открытого запроса, который можно перехватить и
    # подменить. Только в HTTPS-сервере: по HTTP браузер его игнорирует.
    # Срок — сутки: браузер помнит его весь max-age, и откат стенда на HTTP
    # заперёт уже заходивших. Увеличить, когда HTTPS на стенде устоится, —
    # вместе с сервером Grafana ниже.
    add_header Strict-Transport-Security "max-age=86400" always;
    # Без merge location со своим add_header (index.html, /assets/ в
    # site.conf) теряет Alt-Svc и HSTS — а index.html браузер получает первым.
    # add_header_inherit merge задан в site.conf, на уровне этого же server:
    # он нужен и режиму HTTP, а повтор директивы nginx не примет. Там же
    # заголовки безопасности (CSP и другие), общие для обоих режимов.

    acme_certificate letsencrypt ${PUBLIC_HOST};

    ssl_certificate $acme_certificate;
    ssl_certificate_key $acme_certificate_key;
    # Не разбирать сертификат на каждый запрос.
    ssl_certificate_cache max=2;

    include /etc/nginx/site.conf;
}

# Grafana — на своём порту, отдельном от кабинета origin (grafana.conf). Тот
# же сертификат: одинаковый заказ у одного issuer модуль ведёт один раз и
# отдаёт обоим серверам. Без HTTP/3: Grafana он не нужен, а Alt-Svc второго
# порта — лишний заголовок. HSTS — тот же, что у кабинета: он действует на
# адрес целиком, без порта.
server {
    listen 8443 ssl;
    http2 on;
    server_name ${PUBLIC_HOST};

    add_header Strict-Transport-Security "max-age=86400" always;

    acme_certificate letsencrypt ${PUBLIC_HOST};

    ssl_certificate $acme_certificate;
    ssl_certificate_key $acme_certificate_key;
    ssl_certificate_cache max=2;

    include /etc/nginx/grafana.conf;
}
